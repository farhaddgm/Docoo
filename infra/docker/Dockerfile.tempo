# Tempo 2.10.8 retains the single-server architecture; patched Go/dependencies, built in CI.
FROM golang:1.27.2-alpine@sha256:85dc1069ac644ea3c527b177303a406eb3358192816cd7f9e5848eb658851673 AS builder
RUN apk add --no-cache git
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOPROXY="https://proxy.golang.org|direct" GOMAXPROCS=2
ADD --checksum=sha256:c354a7495843161a41ad75d96dd4e8f17aabc9a5f439060cf974a57b4ef2ff85 https://codeload.github.com/grafana/tempo/tar.gz/f0f3ed59197bfe9f54f3b0f8015ccca112f9e544 /tmp/source.tgz
WORKDIR /source
RUN tar -xzf /tmp/source.tgz --strip-components=1 -C /source && rm /tmp/source.tgz && rm -rf vendor
RUN go get golang.org/x/net@v0.60.0 golang.org/x/crypto@v0.55.0 golang.org/x/text@v0.39.0 google.golang.org/grpc@v1.83.2 github.com/apache/thrift@v0.24.0 && \
    go mod tidy && go build -p 2 -trimpath -buildvcs=false -ldflags '-s -w' -o /out/tempo ./cmd/tempo
RUN mkdir -p /out/tempo-data
FROM scratch
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /out/tempo /tempo
COPY --from=builder --chown=1000:1000 /out/tempo-data /var/tempo
USER 1000:1000
ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision="$SOURCE_REVISION" org.docoo.upstream-revision="f0f3ed59197bfe9f54f3b0f8015ccca112f9e544" org.docoo.upstream-version="2.10.8" org.docoo.go-version="1.27.2"
ENTRYPOINT ["/tempo"]
