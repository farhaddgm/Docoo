# One image per service: docker build -f infra/docker/Dockerfile.node \
#   --build-arg PACKAGE=@docoo/api --build-arg START="--import ./dist/instrumentation.js dist/main.js" .
FROM node:25-bookworm-slim@sha256:81db02c4b671288a03915da9534dbd54f96d0e7c24d80ccc54f5b36b2e684370 AS builder
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
WORKDIR /workspace
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile
ARG PACKAGE
# Build the service with its workspace dependencies, then copy it with production
# dependencies only: build tools (TypeScript, esbuild, test runners) never reach the image.
RUN pnpm --filter "${PACKAGE}..." build && pnpm --filter "${PACKAGE}" deploy --prod /service

FROM node:25-bookworm-slim@sha256:81db02c4b671288a03915da9534dbd54f96d0e7c24d80ccc54f5b36b2e684370 AS runner
ENV NODE_ENV=production
# Native tools a service needs at runtime. The ingestion worker is built with
# SYSTEM_PACKAGES="tesseract-ocr tesseract-ocr-eng tesseract-ocr-fas poppler-utils".
ARG SYSTEM_PACKAGES=""
# Services start with plain `node`, so the package managers bundled with the base image (and
# their dependencies, which container scans flag) are removed from the runtime image (SEC-001).
RUN apt-get update && apt-get upgrade -y --no-install-recommends && \
    if [ -n "$SYSTEM_PACKAGES" ]; then apt-get install -y --no-install-recommends $SYSTEM_PACKAGES; fi && \
    rm -rf /var/lib/apt/lists/* && \
    rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
           /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /opt/yarn-*
# Both possible first mounts of the heartbeat volume use PostgreSQL UID 999.
RUN mkdir -p /run/docoo-backup && chown 999:999 /run/docoo-backup
WORKDIR /service
COPY --from=builder --chown=node:node /service /service
# Node arguments of the service, e.g. "--import ./dist/instrumentation.js dist/main.js".
ARG START="dist/main.js"
ENV DOCOO_START=$START
USER node
CMD ["sh", "-c", "exec node $DOCOO_START"]
