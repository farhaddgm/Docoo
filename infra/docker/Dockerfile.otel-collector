FROM golang:1.27.2-alpine@sha256:85dc1069ac644ea3c527b177303a406eb3358192816cd7f9e5848eb658851673 AS builder
RUN apk add --no-cache git
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOPROXY="https://proxy.golang.org|direct" GOMAXPROCS=2
WORKDIR /source
RUN go install go.opentelemetry.io/collector/cmd/builder@v0.162.0
COPY infra/otel/builder.yaml /source/builder.yaml
RUN /go/bin/builder --config /source/builder.yaml --skip-compilation
WORKDIR /source/collector
RUN go get golang.org/x/net@v0.60.0 golang.org/x/crypto@v0.57.0 golang.org/x/text@v0.42.0 google.golang.org/grpc@v1.83.2 && \
    go mod tidy && go build -p 2 -trimpath -buildvcs=false -ldflags '-s -w' -o /out/docoo-otel-collector .
FROM scratch
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /out/docoo-otel-collector /docoo-otel-collector
USER 1000:1000
ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision="$SOURCE_REVISION" org.docoo.upstream-version="0.162.0" org.docoo.go-version="1.27.2"
ENTRYPOINT ["/docoo-otel-collector"]
