# Temporal CLI 1.9.1 (same embedded server/UI) rebuilt with patched Go and patched Echo (GHSA-cxf3-9h37-7rr8).
FROM golang:1.27.3-alpine@sha256:b8c9b82affbbb82a020bbcf998dad2ba9516944ac7e883524642a481a9505e9c AS builder
RUN apk add --no-cache git
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOPROXY="https://proxy.golang.org|direct" GOMAXPROCS=2
ADD --checksum=sha256:2417fbc1348cc3b3e5b01166ebe4c40938d779505d8e119b2ed77bb3d6ae965c https://codeload.github.com/temporalio/cli/tar.gz/1de87a9f26991bf4f5c0a5ff96f2cea8d7a3cbde /tmp/source.tgz
WORKDIR /source
RUN tar -xzf /tmp/source.tgz --strip-components=1 -C /source && rm /tmp/source.tgz
RUN go get golang.org/x/net@v0.60.0 github.com/go-jose/go-jose/v4@v4.1.6 github.com/gomarkdown/markdown@v0.0.0-20260724235538-61af6e1e6971 github.com/labstack/echo/v4@v4.16.1 && go build -p 2 -trimpath -buildvcs=false -ldflags '-s -w -X github.com/temporalio/cli/internal/temporalcli.Version=1.9.1' -o /out/temporal ./cmd/temporal
FROM temporalio/temporal:latest@sha256:ad4c82c97bd12b417d1ea942610dbcd511afb250c4d5ed26c694009533df447e
USER root
RUN apk upgrade --no-cache
COPY --from=builder /out/temporal /usr/local/bin/temporal
USER temporal
