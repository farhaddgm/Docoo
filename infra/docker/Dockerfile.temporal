# Temporal CLI 1.9.1 (same embedded server/UI) rebuilt with patched Go.
FROM golang:1.27.3-alpine@sha256:f2c872bcee949b7be9c490efd02b48a8a2fbf947cdf533f1c58525ec9d8170fd AS builder
RUN apk add --no-cache git
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOPROXY="https://proxy.golang.org|direct" GOMAXPROCS=2
ADD --checksum=sha256:2417fbc1348cc3b3e5b01166ebe4c40938d779505d8e119b2ed77bb3d6ae965c https://codeload.github.com/temporalio/cli/tar.gz/1de87a9f26991bf4f5c0a5ff96f2cea8d7a3cbde /tmp/source.tgz
WORKDIR /source
RUN tar -xzf /tmp/source.tgz --strip-components=1 -C /source && rm /tmp/source.tgz
RUN go get golang.org/x/net@v0.60.0 github.com/gomarkdown/markdown@v0.0.0-20260724235538-61af6e1e6971 && go build -p 2 -trimpath -buildvcs=false -ldflags '-s -w -X github.com/temporalio/cli/internal/temporalcli.Version=1.9.1' -o /out/temporal ./cmd/temporal
FROM temporalio/temporal:latest@sha256:ad4c82c97bd12b417d1ea942610dbcd511afb250c4d5ed26c694009533df447e
USER root
RUN apk upgrade --no-cache
COPY --from=builder /out/temporal /usr/local/bin/temporal
USER temporal
