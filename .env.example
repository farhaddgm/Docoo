# Runtime
NODE_ENV=development
LOG_LEVEL=debug
WEB_PORT=3000
API_PORT=4000
# Per-IP request ceiling per minute (raise only for single-source load or DAST runs)
API_RATE_LIMIT_PER_MINUTE=120
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# PostgreSQL — development values only; generate unique production secrets.
POSTGRES_DB=docoo
POSTGRES_USER=docoo_admin
POSTGRES_PASSWORD=docoo-local-change-me
POSTGRES_RUNTIME_USER=docoo_runtime
POSTGRES_RUNTIME_PASSWORD=docoo-runtime-local-change-me
DATABASE_ADMIN_URL=postgresql://docoo_admin:docoo-local-change-me@localhost:5432/docoo
DATABASE_URL=postgresql://docoo_runtime:docoo-runtime-local-change-me@localhost:5432/docoo

# Redis
REDIS_URL=redis://localhost:6379

# Object storage
S3_ENDPOINT=http://localhost:8333
S3_REGION=eu-north-1
S3_BUCKET=docoo-local
S3_ACCESS_KEY_ID=docoo-local
S3_SECRET_ACCESS_KEY=docoo-local-change-me
S3_FORCE_PATH_STYLE=true
# Endpoint browsers use for presigned uploads when it differs from S3_ENDPOINT (optional). The web
# app adds its origin to the Content-Security-Policy (connect-src), so set it on the web container too.
S3_PUBLIC_ENDPOINT=
S3_API_PORT=8333
S3_CONSOLE_PORT=8888

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Ingestion worker: malware scanner (clamd). Without it every upload stays quarantined.
CLAMD_HOST=localhost
CLAMD_PORT=3310
INGESTION_CONCURRENCY=4

# Authentication
OWNER_EMAIL=farhad.dgm@gmail.com
# Production: keep the following Google credentials in deploy/.env.google (API only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Generate with: openssl rand -base64 32
SESSION_PEPPER=replace-with-at-least-32-random-characters
SESSION_IDLE_TTL_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=86400
PASSWORD_ARGON2_MEMORY_KIB=19456
PASSWORD_ARGON2_ITERATIONS=2
PASSWORD_ARGON2_PARALLELISM=1
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_BASE_SECONDS=900
AUTH_LOCKOUT_MAX_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=1800

# OpenTelemetry (leave empty to disable export)
OTEL_SERVICE_NAME=docoo-api
OTEL_EXPORTER_OTLP_ENDPOINT=

# Provider secrets are envelope-encrypted with this key (32 bytes, base64). Keep it in the
# secret manager; `pnpm env:setup` generates a local one.
SECRET_MASTER_KEY=
# HMAC key for signed document artifacts; falls back to a key derived from SESSION_PEPPER.
ARTIFACT_SIGNING_KEY=
# Password-reset mail. Locally this is the Mailpit inbox from compose (http://localhost:8025);
# in production use your provider, e.g. smtps://user:password@smtp.example.com:465.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Docoo <no-reply@localhost>
# Optional https address of a model price catalog (default: LiteLLM's public catalog on GitHub). Used only by
# the "get prices from the public catalog" button on the AI providers page; leave empty unless the server
# cannot reach GitHub and you host a copy yourself.
MODEL_PRICE_CATALOG_URL=
# Optional Chromium binary for PDF rendering; defaults to the Playwright browser cache.
PLAYWRIGHT_CHROMIUM_EXECUTABLE=

# Workers expose Temporal SDK metrics for Prometheus here (e.g. 0.0.0.0:9471); empty disables.
TEMPORAL_METRICS_ADDRESS=

# External providers — optional until their integration phase.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
SEARCH_API_KEY=
OCR_API_KEY=
# Speech-to-text: any OpenAI-compatible /audio/transcriptions endpoint. Without a key audio
# sources are stored as `partial` (transcription_not_configured).
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_MODEL=whisper-1

# Documentation automation
NOTION_TOKEN=
NOTION_ROOT_PAGE_ID=3e55a24a6668815c9a4fcf4f54df0b31

# Optional remote embeddings; internal content requires separate explicit consent.
KNOWLEDGE_EMBEDDING_ENABLED=false
KNOWLEDGE_EMBEDDING_ALLOW_INTERNAL=false
KNOWLEDGE_EMBEDDING_API_KEY=
KNOWLEDGE_EMBEDDING_MODEL=
