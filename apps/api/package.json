{
  "name": "@docoo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "start": "node dist/main.js",
    "admin:create": "node scripts/create-super-admin.mjs",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run --exclude test/topics.integration.test.ts",
    "test:topics:integration": "vitest run test/topics.integration.test.ts",
    "test:coverage": "vitest run --coverage --exclude test/topics.integration.test.ts"
  },
  "dependencies": {
    "@docoo/config": "workspace:*",
    "@docoo/contracts": "workspace:*",
    "@docoo/database": "workspace:*",
    "@docoo/observability": "workspace:*",
    "@node-rs/argon2": "2.0.2",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.4",
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-fastify": "12.0.3",
    "@nestjs/swagger": "12.0.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.4.2",
    "fastify": "5.12.4",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.3",
    "@types/pg": "8.15.6",
    "tsx": "4.23.13"
  }
}
