{
  "name": "@docoo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file=../../.env --import ./src/instrumentation.ts src/main.ts",
    "start": "node --import ./dist/instrumentation.js dist/main.js",
    "admin:create": "node scripts/create-super-admin.mjs",
    "admin:reset-link": "node scripts/create-reset-link.mjs",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run --exclude 'test/**/*.integration.test.ts'",
    "test:integration": "node -e \"if (!process.env.DATABASE_TEST_ADMIN_URL) { console.error('DATABASE_TEST_ADMIN_URL is required for integration tests.'); process.exit(1); }\" && vitest run .integration.test",
    "test:coverage": "vitest run --coverage --exclude 'test/**/*.integration.test.ts'"
  },
  "dependencies": {
    "@docoo/config": "workspace:*",
    "@docoo/contracts": "workspace:*",
    "@docoo/database": "workspace:*",
    "@docoo/domain": "workspace:*",
    "@docoo/ingestion": "workspace:*",
    "@docoo/knowledge": "workspace:*",
    "@docoo/observability": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.4",
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-fastify": "12.0.3",
    "@nestjs/swagger": "12.0.1",
    "@node-rs/argon2": "2.2.1",
    "@temporalio/client": "1.24.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.4.2",
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.3",
    "@types/pg": "8.15.6",
    "fflate": "0.7.5",
    "tsx": "4.23.13"
  }
}
