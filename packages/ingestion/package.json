{
  "name": "@docoo/ingestion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && vitest run --exclude 'dist/**' --exclude 'src/**/*.integration.test.ts'",
    "test:integration": "tsc -p tsconfig.json && vitest run --exclude 'dist/**' integration",
    "test:coverage": "vitest run --coverage --exclude 'dist/**'",
    "test:acceptance": "vitest run --exclude 'dist/**' acceptance"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1140.0",
    "@aws-sdk/s3-request-presigner": "3.1140.0",
    "@docoo/knowledge": "workspace:*",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.7.5",
    "htmlparser2": "12.0.0",
    "pdfjs-dist": "6.3.289",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.15.6"
  }
}
