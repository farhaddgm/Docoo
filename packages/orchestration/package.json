{
  "name": "@docoo/orchestration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./workflows": {
      "types": "./dist/workflows.d.ts",
      "default": "./dist/workflows.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude 'dist/**'",
    "test:coverage": "vitest run --coverage --exclude 'dist/**'",
    "test:acceptance": "vitest run --exclude 'dist/**' acceptance"
  },
  "dependencies": {
    "@docoo/documents": "workspace:*",
    "@docoo/domain": "workspace:*",
    "@docoo/knowledge": "workspace:*",
    "@docoo/providers": "workspace:*",
    "@temporalio/workflow": "1.24.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.15.6"
  }
}
