{
  "name": "@docoo/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src drizzle.config.ts --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:rls": "node test/rls.integration.mjs && node test/worker-security.integration.mjs",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "ops:backup-drill": "node ops/backup-drill.mjs",
    "ops:load-seed": "node ops/load-seed.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1140.0",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.15.6",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13"
  }
}
