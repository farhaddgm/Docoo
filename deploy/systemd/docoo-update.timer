[Unit]
Description=Look for a new Docoo release every night

[Timer]
# Quiet hours on the server's clock; the random delay keeps servers from asking at once.
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=30min
# A server that was off at that time catches up when it starts again.
Persistent=true

[Install]
WantedBy=timers.target
