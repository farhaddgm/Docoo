# Routes shared by both entry points (Caddyfile: own HTTPS; Caddyfile.edge: behind another proxy).
(docoo_app) {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	# The browser calls /api/...; the API itself serves /v1/...
	handle_path /api/* {
		rewrite * /v1{path}
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy web:3000
	}
}

# Presigned direct uploads and downloads go to the object store under its own host name.
(docoo_files) {
	request_body {
		max_size 500MB
	}
	reverse_proxy object-store:8333
}
